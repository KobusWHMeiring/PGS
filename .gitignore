# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# Local config and secrets — .env is the sole config source (build_principles §VII)
.env
.env.local

# Runtime artefacts
*.log
db.sqlite3
media/
private_media/
staticfiles/
backups/

# Scratch space. HANDOVER §7 tells every session to run throwaway probes from
# `_scratch/` rather than `%TEMP%` (a stray `inspect.py` in the working directory
# shadows the stdlib). An un-ignored scratch dir means the next `git add -A`
# commits a half-written probe.
_scratch/

# Import Linter (A7). Grimp writes this cache next to the config and ships its own
# `.gitignore` containing `*`, so git ignores the contents anyway — but relying on a
# dependency's internal file to keep our tree clean is fragile. Named here too.
.import_linter_cache/

# Playwright
test-results/
playwright-report/

# Editors / OS
.DS_Store
Thumbs.db
.idea/
.vscode/

# NOTE: pgs_docs/ is intentionally NOT ignored. The governing documents
# (OPP, SAOSO v2.1, FORM workbook, checklists) are the source of truth for
# domain language and must be versioned alongside the code that cites them.
