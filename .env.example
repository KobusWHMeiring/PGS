# Copy to .env and fill in. .env is gitignored and is the SOLE config source
# (build_principles.md §VII). Nothing here has a working default in code except
# where noted — if a secret had a default, it would not be a secret.

# --- Django -----------------------------------------------------------------
# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
# Comma-separated. Empty is fine in dev; required in production.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated. Required behind TLS: the browser sends `https://…` as the
# Origin, and Django cannot infer that from a request that reached it over plain
# HTTP on a unix socket. Blank is correct in dev (same-origin matches Host).
# Production: https://organicguarantee.africa,https://www.organicguarantee.africa
CSRF_TRUSTED_ORIGINS=

# TLS/cookie hardening + proxy trust. 0 in dev: with it on, SECURE_SSL_REDIRECT
# sends 127.0.0.1:8000 to an https:// listener that does not exist. Read as an
# explicit deployment fact rather than derived from DEBUG, because Django's test
# runner forces DEBUG=False and that would switch the redirects on under pytest.
# 1 on the VPS — deploy/first-install.sh writes it.
DJANGO_TLS=0

# --- Database ---------------------------------------------------------------
# Matches docker-compose.yml. A2 reads this via dj-database-url.
# Port 5433, not 5432 — see the comment in docker-compose.yml. A native
# PostgreSQL 17 service on this dev box owns 5432.
#
# Production (VPS): `postgres://pgs_user:<generated>@localhost:5432/pgs_db`.
# deploy/first-install.sh writes this line; the password is `openssl rand -hex 16`
# so it needs no URL-encoding. `scripts/backup.sh` parses this URL in shell, so a
# password containing `@` or `/` breaks backups — keep it hex.
DATABASE_URL=postgres://pgs:pgs@localhost:5433/pgs

# --- Redis ------------------------------------------------------------------
# Separate logical databases per build_principles.md §VIII: the broker and the
# cache must never share one, or a flushed cache silently drops queued work.
#
# The VPS runs one Redis for every app, so the DB *numbers* are a shared namespace:
# 7/8/9 are reserved for this deployment. Check before changing them —
# `redis-cli -n 7 dbsize` on a neighbour's number is how two apps end up sharing a
# cache, and the symptom is a task that ran on the wrong site.
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/3
CACHE_URL=redis://localhost:6379/2

# --- Observability ----------------------------------------------------------
# Optional: A2 must run with these blank so a dev box starts without them.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# Screenshots and settings, no PII: POPIA exposure in this project is real.
# Sample traces only when there is a reason to pay for them.
SENTRY_TRACES_SAMPLE_RATE=0
DJANGO_LOG_LEVEL=INFO

# --- Celery -----------------------------------------------------------------
# Run tasks inline instead of queueing. Useful in tests; never in production.
CELERY_TASK_ALWAYS_EAGER=False

# --- Storage paths ----------------------------------------------------------
# Two roots, and the split is a security boundary: evidence photos and voice
# notes are personal data and must never be served from the public root.
# Blank means BASE_DIR/<name>, which is right for dev.
MEDIA_ROOT=
PRIVATE_MEDIA_ROOT=
STATIC_ROOT=

# --- Chatbot / embeddings (sub-plan D) --------------------------------------
# Dev key only. Never a production key in this file.
GEMINI_API_KEY=
# Frozen deliberately at D20 — changing this after B6 invalidates the corpus
# embedding column and requires a full re-embed.
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# --- Grounded chat (sub-plan D) ---------------------------------------------
# The generation model. This is separate from the embedding model above: changing it
# does not require re-embedding the corpus.
CHAT_MODEL=gemini-2.5-flash
# Milliseconds. Every external call declares an explicit timeout (§VII.2).
CHAT_TIMEOUT_MS=30000
# Per-IP budget: this many questions per window, then HTTP 429. Raise it for a
# deployment with a larger Gemini budget; do not remove it.
CHAT_RATE_LIMIT=20
CHAT_RATE_LIMIT_WINDOW_SECONDS=3600
CHAT_MAX_QUESTION_CHARS=500
CHAT_HISTORY_MESSAGES=8
# How many passages the model is given. Eight: at five the cardboard question retrieves
# no inputs clause and refuses. This is the live budget — `_chatbot.RETRIEVAL_LIMIT` is
# only the fallback when the setting is absent.
CHAT_RETRIEVAL_LIMIT=8
# Which `pdftotext` builds the corpus and runs the extraction tests. Empty = `pdftotext`
# from PATH (poppler on Debian/Ubuntu, Xpdf on the dev box). They do NOT produce the same
# bytes, and the parsers' golden page/wrap tables match only the implementation they were
# measured against; `-table` (Appendix 2 verification) exists only in Xpdf 4.x. Pin one per
# deployment, without shadowing `pdftotext` for every other app on the host:
#   PDFTOTEXT_BIN=/opt/xpdf/bin/pdftotext
PDFTOTEXT_BIN=

CHAT_ANSWER_CACHE_TTL=3600
# Output tokens per generation attempt, and the cap one truncation retry may ask for.
# 1024 truncated a four-citation answer mid-JSON, which reached the visitor as
# "the service is unavailable". 2048 truncated too: gemini-2.5-flash's **thinking tokens are
# counted against this cap**, so a heavy think (1962 measured) leaves almost nothing for the
# JSON, and the turn pays for a second call. 4096 leaves room for both. Lower this only with
# a measured reason (`_scratch/answer_probe.py` prints the think and output counts per call).
CHAT_MAX_OUTPUT_TOKENS=4096
CHAT_MAX_OUTPUT_TOKENS_CEILING=8192
