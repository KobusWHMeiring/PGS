# Copy to .env and fill in. .env is gitignored and is the SOLE config source
# (build_principles.md §VII). Nothing here has a working default in code except
# where noted — if a secret had a default, it would not be a secret.

# --- Django -----------------------------------------------------------------
# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
# Comma-separated. Empty is fine in dev; required in production.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---------------------------------------------------------------
# Matches docker-compose.yml. A2 reads this via dj-database-url.
# Port 5433, not 5432 — see the comment in docker-compose.yml. A native
# PostgreSQL 17 service on this dev box owns 5432.
DATABASE_URL=postgres://pgs:pgs@localhost:5433/pgs

# --- Redis ------------------------------------------------------------------
# Separate logical databases per build_principles.md §VIII: the broker and the
# cache must never share one, or a flushed cache silently drops queued work.
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/3
CACHE_URL=redis://localhost:6379/2

# --- Observability ----------------------------------------------------------
# Optional: A2 must run with these blank so a dev box starts without them.
SENTRY_DSN=
DJANGO_LOG_LEVEL=INFO

# --- Chatbot / embeddings (sub-plan D) --------------------------------------
# Dev key only. Never a production key in this file.
GEMINI_API_KEY=
# Frozen deliberately at D20 — changing this after B6 invalidates the corpus
# embedding column and requires a full re-embed.
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIM=768
